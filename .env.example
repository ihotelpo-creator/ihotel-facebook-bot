# ==========================================
# Facebook Messenger Configuration
# ==========================================
# Page Access Token ที่ได้จาก Meta for Developers (Messenger > Settings)
PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN_HERE

# Verify Token ที่คุณกำหนดเอง (ตั้งอะไรก็ได้ แล้วนำไปกรอกในช่อง Verify Token บน Meta)
VERIFY_TOKEN=ihotel_khonkaen_secure_token_2026

# App Secret จาก Meta App Dashboard > Basic Settings (ใช้ตรวจสอบ payload integrity)
APP_SECRET=YOUR_APP_SECRET_HERE

# ==========================================
# Google Gemini AI Configuration
# ==========================================
# API Key จาก Google AI Studio (https://aistudio.google.com/app/apikey) - ฟรี!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==========================================
# Server Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0
